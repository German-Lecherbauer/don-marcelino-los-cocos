@DonMarcelino.Api_HostAddress = http://localhost:5106

@token = PEGA_ACA_TOKEN_ADMIN
@tokenConsulta = PEGA_ACA_TOKEN_CONSULTA
@tokenOperador = PEGA_ACA_TOKEN_OPERADOR


###############################################
# HEALTH
###############################################

### Health
GET {{DonMarcelino.Api_HostAddress}}/api/health


###############################################
# AUTH
###############################################

### Login Admin
POST {{DonMarcelino.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@donmarcelino.com",
  "password": "Admin123!"
}


### Login Consulta
POST {{DonMarcelino.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "consulta@donmarcelino.com",
  "password": "Consulta123!"
}


### Login Operador
POST {{DonMarcelino.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "operador@donmarcelino.com",
  "password": "Operador123!"
}


###############################################
# DASHBOARD
###############################################

### Dashboard Admin
GET {{DonMarcelino.Api_HostAddress}}/api/dashboard/resumen
Authorization: Bearer {{token}}


### Dashboard Operador
GET {{DonMarcelino.Api_HostAddress}}/api/dashboard/resumen
Authorization: Bearer {{tokenOperador}}


### Dashboard Consulta
GET {{DonMarcelino.Api_HostAddress}}/api/dashboard/resumen
Authorization: Bearer {{tokenConsulta}}


###############################################
# PACIENTES
###############################################

### Listar pacientes
GET {{DonMarcelino.Api_HostAddress}}/api/pacientes
Authorization: Bearer {{token}}


### Crear paciente
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Paciente",
  "apellido": "Prueba",
  "email": "paciente.prueba@donmarcelino.com",
  "documento": "12345678"
}


###############################################
# MEMBRESÍAS
###############################################

### Listar todas las membresías
GET {{DonMarcelino.Api_HostAddress}}/api/membresias
Authorization: Bearer {{token}}
Accept: application/json


### Listar membresías de un paciente
@pacienteId = PEGA_ACA_ID_PACIENTE

GET {{DonMarcelino.Api_HostAddress}}/api/pacientes/{{pacienteId}}/membresias
Authorization: Bearer {{token}}


### Obtener membresía por ID
@membresiaId = PEGA_ACA_ID_MEMBRESIA

GET {{DonMarcelino.Api_HostAddress}}/api/membresias/{{membresiaId}}
Authorization: Bearer {{token}}


### Crear membresía para paciente
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes/{{pacienteId}}/membresias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fechaInicio": "2026-09-10T00:00:00Z",
  "fechaVencimiento": "2027-09-10T00:00:00Z"
}


### Cambiar estado de membresía
PATCH {{DonMarcelino.Api_HostAddress}}/api/membresias/{{membresiaId}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": 3
}


###############################################
# USUARIOS
###############################################

### Listar usuarios
GET {{DonMarcelino.Api_HostAddress}}/api/usuarios
Authorization: Bearer {{token}}


### Crear usuario
POST {{DonMarcelino.Api_HostAddress}}/api/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Usuario Prueba",
  "email": "usuario.prueba@donmarcelino.com",
  "password": "Usuario123!",
  "rol": 3
}


### Cambiar rol de usuario
@usuarioId = PEGA_ACA_ID_USUARIO

PATCH {{DonMarcelino.Api_HostAddress}}/api/usuarios/{{usuarioId}}/rol
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rol": 2
}


### Cambiar estado de usuario
PATCH {{DonMarcelino.Api_HostAddress}}/api/usuarios/{{usuarioId}}/estado?activo=true
Authorization: Bearer {{token}}


###############################################
# AUDITORÍA
###############################################

### Listar auditorías
GET {{DonMarcelino.Api_HostAddress}}/api/auditorias
Authorization: Bearer {{token}}