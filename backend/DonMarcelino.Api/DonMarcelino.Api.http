###############################################
# PACIENTES
###############################################

### Crear paciente Germán
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "German",
  "apellido": "Prueba",
  "email": "german.prueba@donmarcelino.com",
  "documento": "12345678"
}


### Listar pacientes SIN token
# Debe devolver 401
GET {{DonMarcelino.Api_HostAddress}}/api/pacientes


### Listar pacientes con Admin
GET {{DonMarcelino.Api_HostAddress}}/api/pacientes
Authorization: Bearer {{token}}


### Obtener paciente Germán por ID
GET {{DonMarcelino.Api_HostAddress}}/api/pacientes/7734785f-57cf-40a1-a911-f581c0e8e8ac
Authorization: Bearer {{token}}


### Actualizar paciente Germán
PUT {{DonMarcelino.Api_HostAddress}}/api/pacientes/7734785f-57cf-40a1-a911-f581c0e8e8ac
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "German",
  "apellido": "Actualizado",
  "email": "german.prueba@donmarcelino.com",
  "documento": "12345678"
}


### Desactivar paciente Germán
DELETE {{DonMarcelino.Api_HostAddress}}/api/pacientes/7734785f-57cf-40a1-a911-f581c0e8e8ac
Authorization: Bearer {{token}}


### Crear paciente Lucía
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Lucia",
  "apellido": "Activa",
  "email": "lucia.activa@donmarcelino.com",
  "documento": "87654321"
}


###############################################
# PERMISOS DE PACIENTES
###############################################

### Consulta puede listar pacientes
# Debe devolver 200
GET {{DonMarcelino.Api_HostAddress}}/api/pacientes
Authorization: Bearer {{tokenConsulta}}


### Consulta NO puede crear pacientes
# Debe devolver 403
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes
Authorization: Bearer {{tokenConsulta}}
Content-Type: application/json

{
  "nombre": "No",
  "apellido": "Permitido",
  "email": "no.permitido@donmarcelino.com",
  "documento": "99999999"
}


### Operador puede crear pacientes
# Puede devolver 201 o 400 si Carlos ya existe
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes
Authorization: Bearer {{tokenOperador}}
Content-Type: application/json

{
  "nombre": "Carlos",
  "apellido": "Operador",
  "email": "carlos.operador@donmarcelino.com",
  "documento": "40111222"
}


###############################################
# MEMBRESÍAS
###############################################

### Intentar crear membresía para Germán inactivo
# Debe devolver 400 si Germán está inactivo
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes/7734785f-57cf-40a1-a911-f581c0e8e8ac/membresias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fechaInicio": "2026-09-05T00:00:00Z",
  "fechaVencimiento": "2027-09-05T00:00:00Z"
}


### Crear membresía activa para Lucía
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes/1dd542c5-2981-43cd-b889-49363182eb59/membresias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fechaInicio": "2026-09-05T00:00:00Z",
  "fechaVencimiento": "2027-09-05T00:00:00Z"
}


### Intentar crear segunda membresía activa para Lucía
# Debe devolver 400
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes/1dd542c5-2981-43cd-b889-49363182eb59/membresias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fechaInicio": "2026-09-06T00:00:00Z",
  "fechaVencimiento": "2027-09-06T00:00:00Z"
}


### Listar membresías de Lucía
GET {{DonMarcelino.Api_HostAddress}}/api/pacientes/1dd542c5-2981-43cd-b889-49363182eb59/membresias
Authorization: Bearer {{token}}


### Obtener membresía por ID
GET {{DonMarcelino.Api_HostAddress}}/api/membresias/1c6f9596-8b55-4849-b1ad-e8d4477e6355
Authorization: Bearer {{token}}


### Obtener membresía inexistente
# Debe devolver 404
GET {{DonMarcelino.Api_HostAddress}}/api/membresias/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}


### Actualizar fechas de membresía
PUT {{DonMarcelino.Api_HostAddress}}/api/membresias/1c6f9596-8b55-4849-b1ad-e8d4477e6355
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fechaInicio": "2026-09-10T00:00:00Z",
  "fechaVencimiento": "2027-09-10T00:00:00Z"
}


### Suspender membresía de Lucía
PATCH {{DonMarcelino.Api_HostAddress}}/api/membresias/1c6f9596-8b55-4849-b1ad-e8d4477e6355/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": 3
}


### Membresía con fechas inválidas
# Debe devolver 400
POST {{DonMarcelino.Api_HostAddress}}/api/pacientes/1dd542c5-2981-43cd-b889-49363182eb59/membresias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fechaInicio": "2027-09-10T00:00:00Z",
  "fechaVencimiento": "2026-09-10T00:00:00Z"
}


